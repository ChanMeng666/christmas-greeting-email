{
  "project": "send-joy",
  "baseUrl": "https://sendjoy.chanmeng-dev.workers.dev",
  "outDir": "docs/showcase",

  "viewports": {
    "desktop": { "width": 1280, "height": 800, "deviceScaleFactor": 2 },
    "mobile":  { "width": 390,  "height": 844, "deviceScaleFactor": 3, "isMobile": true }
  },

  "reducedMotion": "reduce",

  "setup": [
    { "action": "click", "selector": "text=I already know how to use this, skip the tour", "optional": true, "timeoutMs": 4000 },
    { "action": "wait", "ms": 500 }
  ],

  "pages": [
    {
      "label": "hero",
      "url": "/",
      "viewport": "desktop",
      "fullPage": false,
      "before": [
        { "action": "wait", "ms": 2000 },
        { "action": "click", "selector": "text=I already know how to use this, skip the tour", "optional": true, "timeoutMs": 4000 },
        { "action": "wait", "ms": 800 }
      ]
    },
    {
      "label": "templates",
      "url": "/templates",
      "viewport": "desktop",
      "fullPage": false,
      "before": [
        { "action": "wait", "ms": 2500 }
      ]
    },
    {
      "label": "mobile-hero",
      "url": "/",
      "viewport": "mobile",
      "fullPage": false,
      "before": [
        { "action": "wait", "ms": 2000 },
        { "action": "click", "selector": "text=I already know how to use this, skip the tour", "optional": true, "timeoutMs": 4000 },
        { "action": "wait", "ms": 800 }
      ]
    }
  ],

  "demo": {
    "size": { "width": 1280, "height": 720 },
    "stepPauseMs": 500,
    "steps": [
      { "action": "goto", "url": "/", "timeoutMs": 15000 },
      { "action": "wait", "ms": 1800 },
      { "action": "goto", "url": "/templates", "timeoutMs": 15000 },
      { "action": "wait", "ms": 2500 },
      { "action": "scroll", "by": 450 },
      { "action": "wait", "ms": 1200 }
    ]
  }
}
